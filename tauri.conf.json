{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GakumasLauncher",
  "version": "0.1.1",
  "identifier": "local.gakumas.launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "학원 아이돌마스터",
        "width": 420,
        "height": 780,
        "resizable": false,
        "maximizable": false,
        "center": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
